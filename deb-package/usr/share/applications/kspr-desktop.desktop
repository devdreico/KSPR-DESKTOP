[Desktop Entry]
Version=1.0
Type=Application
Name=KSPR Desktop
GenericName=AI Code Assistant
Comment=AI-powered code analysis and assistance
Exec=/opt/kspr-desktop/kspr-launcher.sh %F
Icon=kspr-desktop
Terminal=false
Categories=Development;IDE;Programming;
Keywords=kspr;ai;code;analysis;assistant;development;
MimeType=text/plain;inode/directory;
StartupNotify=true
StartupWMClass=kspr-desktop
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=/opt/kspr-desktop/kspr-launcher.sh
