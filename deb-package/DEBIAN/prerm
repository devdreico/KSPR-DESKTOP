#!/bin/bash
set -e

# Pre-removal script for KSPR Desktop

echo ""
echo "  Desinstalando KSPR Desktop..."
echo ""

# Stop running processes
echo "[*] Deteniendo procesos..."
pkill -f "kspr-desktop" 2>/dev/null || true
pkill -f "kspr-launcher" 2>/dev/null || true
pkill -f "kspr serve" 2>/dev/null || true

# Remove symbolic link
echo "[*] Removiendo enlaces simbolicos..."
rm -f /usr/local/bin/kspr-desktop

# Remove desktop entry
echo "[*] Removiendo entrada de escritorio..."
rm -f /usr/share/applications/kspr-desktop.desktop

# Update desktop database
if command -v update-desktop-database &> /dev/null; then
    update-desktop-database /usr/share/applications 2>/dev/null || true
fi

# Update icon cache
if command -v gtk-update-icon-cache &> /dev/null; then
    gtk-update-icon-cache /usr/share/icons/hicolor 2>/dev/null || true
fi

echo "  KSPR Desktop desinstalado."
echo ""
