#!/bin/bash
set -e

# Post-removal script for KSPR Desktop

echo ""
echo "  Limpiando KSPR Desktop..."
echo ""

# Remove installation directory
echo "[*] Removiendo archivos de instalacion..."
rm -rf /opt/kspr-desktop

# Remove configuration directory
echo "[*] Removiendo configuracion..."
rm -rf "$HOME/.kspr"

# Remove icons from all sizes
echo "[*] Removiendo iconos..."
for size in 16 22 24 32 48 64 128 256 512 1024; do
    rm -f "/usr/share/icons/hicolor/${size}x${size}/apps/kspr-desktop.png" 2>/dev/null || true
done

# Remove any temp files
echo "[*] Limpiando archivos temporales..."
rm -rf /tmp/kspr-*

# Update desktop database
if command -v update-desktop-database &> /dev/null; then
    update-desktop-database /usr/share/applications 2>/dev/null || true
fi

# Update icon cache
if command -v gtk-update-icon-cache &> /dev/null; then
    gtk-update-icon-cache /usr/share/icons/hicolor 2>/dev/null || true
fi

echo "  KSPR Desktop removido completamente."
echo ""
